# Application
PORT=3000

# Database
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=aam_admin
POSTGRES_PASSWORD=aam_admin_secret
POSTGRES_DB=aam_admin

# GitHub Actions OIDC
# The audience claim expected in the GitHub OIDC token (must match workflow's `aud`)
GITHUB_OIDC_AUDIENCE=https://admin.aam-digital.app
# The GitHub repository allowed to authenticate (e.g. Aam-Digital/ndb-setup)
GITHUB_REPOSITORY=Aam-Digital/aam-cloud-infrastructure

# Password for accessing the API with Basic Auth user "admin"
ADMIN_PASSWORD=

# Sentry
SENTRY_DSN=
SENTRY_ENVIRONMENT=development

# GitHub API token for dispatching workflows in `aam-cloud-infrastructure`.
# Needs the `actions:write` permission.
GITHUB_API_TOKEN=

# Name of Pulumi infrastructure stack of project aam-cloud-instances [1] to deploy when a
# new instance is created (e.g. staging, production).
#
# [1]: https://github.com/Aam-Digital/aam-cloud-infrastructure/tree/main/infra/aam-digital-instances
INFRA_STACK=staging

# Brevo Webhook
BREVO_WEBHOOK_TOKEN=change-me-in-production
# Comma-separated list of Brevo IP ranges (CIDR notation)
BREVO_ALLOWED_IPS=1.179.112.0/20
